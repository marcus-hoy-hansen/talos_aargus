// Slurm settings used only by the FastSpliceAI scoring process.
process {
    withName: AnnotateWithFastSpliceAi {
        executor = 'slurm'
        queue = System.getenv('FASTSPLICEAI_QUEUE') ?: 'gpu-l40s,gpu-h200'
        clusterOptions = System.getenv('FASTSPLICEAI_CLUSTER_OPTIONS') ?: '--account=reanalyses_auh --gpus=1'
        cpus = (System.getenv('FASTSPLICEAI_CPUS') ?: '6') as Integer
        memory = System.getenv('FASTSPLICEAI_MEM') ?: '16 GB'
        time = System.getenv('FASTSPLICEAI_TIME') ?: '08:00:00'
    }
    withName: RunFastSpliceAi {
        executor = 'slurm'
        queue = System.getenv('FASTSPLICEAI_QUEUE') ?: 'gpu-l40s,gpu-h200'
        clusterOptions = System.getenv('FASTSPLICEAI_CLUSTER_OPTIONS') ?: '--account=reanalyses_auh --gpus=1'
        cpus = (System.getenv('FASTSPLICEAI_CPUS') ?: '6') as Integer
        memory = System.getenv('FASTSPLICEAI_MEM') ?: '16 GB'
        time = System.getenv('FASTSPLICEAI_TIME') ?: '08:00:00'
    }
}
